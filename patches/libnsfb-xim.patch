     xcb_shm_seg_t segment; /* The handle to the image shared memory */
 } xstate_t;
 
+/*
+ * Suzume integration hooks.
+ *
+ * libnsfb exposes only translated keycodes via nsfb_event_t; for XIM we need the
+ * raw X11 keycode + modifier state, and the native window id.
+ */
+unsigned int nsfb_x_last_keycode = 0;
+unsigned int nsfb_x_last_keystate = 0;
+
+unsigned long nsfb_x_get_window_id(nsfb_t *nsfb)
+{
+    xstate_t *xstate = nsfb->surface_priv;
+    if (xstate == NULL) {
+        return 0;
+    }
+    return (unsigned long)xstate->window;
+}
+
+/* X cursor-font glyphs for the suzume cursor shapes
+ * (0=arrow, 1=pointer/hand, 2=text/I-beam). */
+static xcb_cursor_t
+x_create_font_cursor(xcb_connection_t *conn, uint16_t glyph)
+{
+    static const char font_name[] = "cursor";
+    xcb_font_t font = xcb_generate_id(conn);
+    xcb_cursor_t cur = xcb_generate_id(conn);
+    xcb_open_font(conn, font, sizeof(font_name) - 1, font_name);
+    /* fg black, bg white; mask glyph is glyph+1 by cursor-font convention */
+    xcb_create_glyph_cursor(conn, cur, font, font, glyph, glyph + 1,
+                            0, 0, 0, 0xffff, 0xffff, 0xffff);
+    xcb_close_font(conn, font);
+    return cur;
+}
+
+void nsfb_x_set_cursor_shape(nsfb_t *nsfb, int shape)
+{
+    /* XC_left_ptr, XC_hand2, XC_xterm */
+    static const uint16_t glyphs[3] = { 68, 60, 152 };
+    static xcb_cursor_t cache[3] = { XCB_NONE, XCB_NONE, XCB_NONE };
+    xstate_t *xstate;
+    uint32_t value;
+
+    if (nsfb == NULL || shape < 0 || shape > 2)
+        return;
+    xstate = nsfb->surface_priv;
+    if (xstate == NULL)
+        return;
+    if (cache[shape] == XCB_NONE)
+        cache[shape] = x_create_font_cursor(xstate->connection, glyphs[shape]);
+    value = cache[shape];
+    xcb_change_window_attributes(xstate->connection, xstate->window,
+                                 XCB_CW_CURSOR, &value);
+    xcb_flush(xstate->connection);
+}
+
