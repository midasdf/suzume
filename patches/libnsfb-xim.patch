+/*
+ * Suzume integration hooks.
+ *
+ * libnsfb exposes only translated keycodes via nsfb_event_t; for XIM we need the
+ * raw X11 keycode + modifier state, and the native window id.
+ */
+unsigned int nsfb_x_last_keycode = 0;
+unsigned int nsfb_x_last_keystate = 0;
+
+unsigned long nsfb_x_get_window_id(nsfb_t *nsfb)
+{
+    xstate_t *xstate = nsfb->surface_priv;
+    if (xstate == NULL) {
+        return 0;
+    }
+    return (unsigned long)xstate->window;
+}
+
+void nsfb_x_set_cursor_shape(nsfb_t *nsfb, int shape)
+{
+    (void)nsfb;
+    (void)shape;
+    /* TODO: Implement real cursor shapes (arrow/pointer/text) if needed. */
+}
